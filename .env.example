# Copy to .env. Every variable is optional; the value shown is the image default unless noted.
# NOTHING SECRET GOES HERE: the Klei token lives in cluster_token.txt (or the file CLUSTER_TOKEN_FILE names),
# the join password in cluster.ini. See README.

# Owner of everything the server writes under /data. Match the owner of the host directory you mount.
PUID=1000
PGID=1000

# Used ONLY on the first start, to generate Cluster_1/cluster.ini and the shard server.ini files. Once the
# cluster exists these are ignored; edit the files instead.
CLUSTER_NAME=Don't Starve Together
CLUSTER_DESCRIPTION=
CLUSTER_INTENTION=cooperative      # cooperative | competitive | social | madness
MAX_PLAYERS=16                     # 1..64
GAME_MODE=survival                 # survival | endless | wilderness
PVP=false
PAUSE_WHEN_EMPTY=false
OFFLINE_CLUSTER=false              # true = LAN only, no token needed, never listed

# Caves shard alongside the Master (Forest) shard. Applies on every start; also decides whether the Caves
# directory is generated on the first one.
CAVES=true

# Klei cluster token. Prefer a file (a Docker/compose secret); CLUSTER_TOKEN=... works too. With neither set
# the token already in Cluster_1/cluster_token.txt is used. Unset = leave the example commented out.
# CLUSTER_TOKEN_FILE=/run/secrets/cluster_token

# DepotDownloader re-validates the game files against Steam's current build on every start (~1 min for the
# 4 GB install). DST clients must match the server build, so leave this on unless you pin deliberately.
UPDATE_ON_START=true
# Poll Steam every N minutes while running; on a new build: save + shut down both shards, fetch, relaunch.
AUTO_UPDATE_INTERVAL_MINUTES=0
# Seconds to wait for c_shutdown(true) to save and exit before SIGTERM. Keep below stop_grace_period.
STOP_TIMEOUT_SECONDS=240
